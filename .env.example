# Copie este arquivo para ".env" e preencha com os valores reais da sua
# instalacao. NUNCA commite o ".env" (ja esta no .gitignore) - tudo aqui e
# segredo (senha/token/apikey) ou varia por maquina (path de modelo), ao
# contrario de config/config.json, que so guarda dados nao-sensiveis
# (nomes, IPs, flags de evento) e o NOME das variaveis abaixo quando
# aplicavel (ex: "password_env": "CAM_WIFI_LOCAL_PASSWORD").

# Obrigatoria para o envio de alertas por WhatsApp via Evolution API.
EVOLUTION_API_KEY=sua_chave_aqui

# Opcionais - sobrescrevem config.json quando definidas (uteis para trocar
# de instancia/ambiente sem editar o arquivo versionavel). Endpoint/instancia
# nao sao segredo, mas podem ser definidos aqui por conveniencia.
#KINESIS_WHATSAPP_ENDPOINT=https://message.senszia.com
#KINESIS_WHATSAPP_INSTANCE=senszia

# Senha RTSP de cada camera com "ip" configurado em config.json - o nome da
# variavel e o que voce escolher em "password_env" na fonte correspondente
# (ver config/config.example.json). Uma variavel por camera.
#CAM_WIFI_LOCAL_PASSWORD=troque_pela_senha_real
#CAM_REMOTA_TAILSCALE_PASSWORD=troque_pela_senha_real

# Token do servidor remoto somente-leitura (src/server/remote_server.py) -
# obrigatorio quando remote_server.enabled=true em config.json. E o UNICO
# controle de acesso ao servidor: use um valor longo e unico, nunca o
# exemplo abaixo, e distribua so a quem deve ter acesso.
#KINESIS_REMOTE_SERVER_TOKEN=troque_por_um_token_longo_e_unico

# Path local de um modelo faster-whisper ja convertido (voice.model_dir em
# config.json) - so necessario se voice.enabled=true e o download automatico
# do Hugging Face Hub nao for viavel na maquina de instalacao.
#KINESIS_VOICE_MODEL_DIR=/caminho/para/o/modelo/convertido

# Diretorio onde pesos de modelos YOLO sao baixados (default: models/ na
# raiz do projeto) - normalmente nao precisa ser alterado.
#KINESIS_MODELS_DIR=/caminho/alternativo/para/models
